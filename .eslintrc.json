{
    "env": {
        "browser": true,
        "es2021": true
    },
    "parserOptions": {
        "ecmaVersion": "latest"
    },
    "rules": {
        "no-undef": "warn",
        "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
        "no-console": "off",
        "eqeqeq": ["warn", "allow-null"],
        "no-empty": "warn",
        "no-unreachable": "error",
        "no-constant-condition": "warn",
        "no-dupe-keys": "error",
        "no-duplicate-case": "error",
        "no-redeclare": ["error", { "builtinGlobals": false }],
        "no-self-assign": "error",
        "no-self-compare": "error"
    },
    "globals": {
        "CONFIG": "readonly",
        "Auth": "readonly",
        "Logger": "readonly",
        "SheetsAPI": "readonly",
        "confetti": "readonly",
        "EleveConnaissances": "readonly",
        "EleveEntrainement": "readonly",
        "parseJSONField": "readonly",
        "FORMAT_HANDLERS": "readonly",
        "EleveExercices": "readonly",
        "EleveEvaluation": "readonly",
        "EleveLayout": "readonly",
        "AdminLayout": "readonly",
        "AdminBanquesExercices": "readonly",
        "EleveAccueil": "readonly",
        "EleveChapitre": "readonly",
        "EleveClasseur": "readonly",
        "EleveEmploiDuTemps": "readonly",
        "EleveEvaluations": "readonly",
        "EleveFaq": "readonly",
        "EleveLecons": "readonly",
        "EleveMethodologie": "readonly",
        "EleveMethodologieParcours": "readonly",
        "EleveRecommandations": "readonly",
        "EleveVideos": "readonly",
        "EleveCompetences": "readonly",
        "SubmissionUtils": "readonly",
        "AdminCorrections": "readonly",
        "escapeHtml": "readonly"
    }
}
